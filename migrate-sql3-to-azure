import sqlite3
import pymssql

# SQLite
sqlite_conn = sqlite3.connect('db.sqlite')
sqlite_cursor = sqlite_conn.cursor()

# Azure SQL
azure_conn = pymssql.connect(
    server='testserverforstudent.database.windows.net',
    user='pgsql',
    password='TWOJE_HASLO',
    database='test'
)
azure_cursor = azure_conn.cursor()

# Utwórz tabelę
azure_cursor.execute("""
    IF NOT EXISTS (SELECT * FROM sys.tables WHERE name = 'users')
    CREATE TABLE users (
        id INT IDENTITY(1,1) PRIMARY KEY,
        name NVARCHAR(255) NOT NULL
    )
""")

# Przenieś dane
sqlite_cursor.execute("SELECT name FROM users")
for row in sqlite_cursor.fetchall():
    azure_cursor.execute("INSERT INTO users (name) VALUES (%s)", (row[0],))

azure_conn.commit()
print("Migracja zakończona")

sqlite_conn.close()
azure_conn.close()
